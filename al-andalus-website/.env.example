# Payload CMS
# Local dev:
DATABASE_URI=file:./database.db
#
# Staging/production (Hostinger):
# Do NOT use account-level ~/private/data — File Manager can see it, but the Node
# app is often jailed to the domain tree and returns SQLite error 14 (CANTOPEN).
# Put the DB under the SAME domain as the app, OUTSIDE the nodejs/ deploy folder:
#
#   File Manager: domains/<your-hostingersite>/private/data/database.db
#   DATABASE_URI=file:///home/u123456/domains/<your-hostingersite>/private/data/database.db
#
# Alternative (also outside nodejs/): domains/<site>/data/database.db
# Keep PAYLOAD_SECRET identical across deploys. Never use file:./database.db on Hostinger
# if deploys wipe nodejs/ — that resets the dashboard every push.
# Optional Turso/libSQL auth token
# DATABASE_AUTH_TOKEN=

# REQUIRED in production: 32+ character random string
PAYLOAD_SECRET=change-me-to-a-long-random-string-at-least-32

# Schema push is OPT-IN (PAYLOAD_DATABASE_PUSH=true). Leave unset/false for normal
# local + production runs. Auto-push causes SQLite "index already exists" crashes
# when Drizzle's snapshot drifts from the real DB.
# After intentional CMS schema changes (local or Hostinger):
#   1) PAYLOAD_DATABASE_PUSH=true
#   2) Restart the app (schema updates apply)
#   3) PAYLOAD_DATABASE_PUSH=false  (or remove the var)
# Without a successful first push on a brand-new empty DB, /admin can crash with:
# Cannot destructure property 'admin'
# PAYLOAD_DATABASE_PUSH=true
# PAYLOAD_DATABASE_PUSH=false

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:8080

# Form notification inboxes (all default to info@alandalus-iq.com)
# CONTACT_TO_EMAIL=info@alandalus-iq.com
# CAREERS_TO_EMAIL=info@alandalus-iq.com
# QUOTES_TO_EMAIL=info@alandalus-iq.com

# SMTP — required for real email delivery of form notifications
# Without these, submissions still save to the dashboard; email failure is logged only
# Credentials must stay in env only — do not hardcode. Same transport is shared via Payload.
# SMTP_HOST=mail.alandalus-iq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=website@alandalus-iq.com
# SMTP_PASS=
# SMTP_FROM_ADDRESS=website@alandalus-iq.com
# SMTP_FROM_NAME=Al-Andalus Insurance
# SMTP_SKIP_VERIFY=true

# Seed endpoint (GET /api/seed) — disabled unless BOTH are set
# ALLOW_SEED=true
# SEED_SECRET=generate-a-long-random-string
# PARTNERS_LOGOS_DIR=./public/partners-logos

# Optional: enable GraphQL playground in production (default: off)
# ENABLE_GRAPHQL_PLAYGROUND=true
